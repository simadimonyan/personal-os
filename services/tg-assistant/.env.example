# === СЕКРЕТЫ — скопируй в .env и заполни. .env в .gitignore, в git не попадает. ===

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Твой Telegram user id (узнать у @userinfobot). Бот отвечает ТОЛЬКО этому id.
OWNER_ID=000000000

# Часовой пояс для расписания и дат (IANA-имя). Влияет на дату дневного файла и время слотов.
TZ=Europe/Moscow

# Путь к config.toml (опц., по умолчанию ./config.toml рядом с run.py)
# CONFIG_PATH=/Users/dimitrisimonyan/tg-psych-bot/config.toml

# === TODOIST (опц.) — таск-менеджер синхронизируется с Todoist ===
# API-токен: Todoist → Settings → Integrations → Developer → API token.
# Если задан — интеграция включается автоматически (3-сторонняя синхра бот↔Obsidian↔Todoist).
# TODOIST_TOKEN=0123456789abcdef0123456789abcdef01234567

# === КАНАЛ-МОНИТОРИНГ (опц.) ===
# После настройки канала: в config.toml установи channel.enabled=true и channel.channel_id
# Бот должен быть администратором группы с правами: Read messages, React to messages
# Реакции (MessageReactionUpdated) приходят только если бот админ группы.
