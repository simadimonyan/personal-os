# секреты
.env

# рантайм-данные (саму папку держим через .gitkeep, содержимое игнорим)
data/*
!data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# логи (папку держим, файлы игнорим)
logs/*
!logs/.gitkeep

# python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# os
.DS_Store

# временные файлы записи в obsidian (на случай краша)
*.tmp
