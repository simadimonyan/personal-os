# === OS ===
.DS_Store

# === Secrets / env ===
.env
*.env
!example.env

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# === Node ===
node_modules/

# === Databases (vector DBs + runtime data — not code) ===
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Obsidian vector DB + its embedding sidecar files
tools/obsidian/tools/obsidian_vectors.db*

# === Logs ===
*.log
services/logs/

# === Runtime state & generated data ===
services/pos_state.json
services/*/data/*
!services/*/data/.gitkeep

# === Generated graph artifacts (regenerated by the obsidian tool) ===
tools/obsidian/tools/graph/graph.html
tools/obsidian/tools/graph/graph.json

# Zotero vector index (derived, rebuildable via vectorize.py)
tools/zotero/zotero_vectors.db
tools/zotero/_*.npy
tools/zotero/graph/
tools/zotero/status.json
tools/zotero/.fingerprint.json
tools/zotero/zotero_vectors.db-*

# blog base (local data)
tools/blog/blog.db
tools/blog/blog.db-*

# Социальный капитал — личные контакты (данные, не код): база под общим *.db,
# но граф и выгрузка содержат имена/почты/телефоны — в репозиторий не попадают
tools/social-capital/graph/
tools/social-capital/contacts.csv
tools/social-capital/imports/

# Очередь переиндексации от хука post_write_vault — рабочее состояние машины,
# а не код: пути правленых заметок, живёт до ближайшего прогона vault-indexer
tools/obsidian/tools/.reindex-queue

# Сессии Telegram-аккаунтов (ферма) — наружу не отдаём
accounts.json
# Недоведённый вход (auth-relay): в нём ключ авторизации новой сессии
.auth-pending.json

# Reddit — доступы к API (client_secret + пароль аккаунта) и локальная база
tools/reddit/config.json
tools/reddit/reddit.db
tools/reddit/reddit.db-*

# Пикабу — свои гарды и локальная база площадок/постов (сессия — в ~/.pikabu-session)
tools/pikabu/config.json
tools/pikabu/pikabu.db
tools/pikabu/pikabu.db-*

# Stack Overflow for Agents — API-ключ агента (личный, не в git)
.sofa/

# Чекпоинты и учёт бюджета контекста — рабочее состояние, не история
.claude/state/

# === Личные данные и рантайм-состояние (не код) ===
# hh: профиль для писем, сопроводительное, история откликов, кэш резюме
services/hh-autoapply/profile.txt
services/hh-autoapply/cover.txt
services/hh-autoapply/applied.json
services/hh-autoapply/bot_seen.json
services/hh-autoapply/resumes_cache.json
services/hh-autoapply/run_state.json
# cron: состояние планировщика и тексты рассылок
services/cron/state.json
services/cron/messages/
# состояние сервисов
services/mission-control/claude_sessions.json
services/sources-index/status.json
# конвейер памяти: пути ко всем личным заметкам Obsidian + статистика прогонов
.claude/hooks/.memory-state.json
.claude/hooks/memory_status.json
# telegram: chat_id личных чатов
.claude/skills/tg-freelance-blast/references/known_chats.txt
# yandex-forms: перехваченный трафик (CSRF-токены) и скриншоты личного кабинета
tools/yandex-forms/shots/
tools/yandex-forms/forms.json
tools/yandex-forms/forms.json.bak

# === Веса моделей (качаются сами, в репозитории не нужны) ===
tools/obsidian/tools/models/
services/radar/model/

# Граф источников — генерируемый артефакт (имена заметок и источников)
tools/sources/graph/

# Замок конвейера памяти — живёт на время прогона
.claude/hooks/.memory-update.lock
