# === ML model weights → Git LFS ===
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text
*.gguf        filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.h5          filter=lfs diff=lfs merge=lfs -text

# HuggingFace cache blobs (SHA-named, no extension)
tools/obsidian/tools/models/hub/**/blobs/** filter=lfs diff=lfs merge=lfs -text

# Large tokenizer files living inside model directories
tools/obsidian/tools/models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
services/radar/model/tokenizer.json           filter=lfs diff=lfs merge=lfs -text
